{
  "name": "casebridge-root",
  "version": "1.0.0",
  "description": "CaseBridge - AICTE Institution Complaint Monitoring & Coordination System (SIH 2026)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "test": "node server/test/test-flows.js",
    "test:http": "node server/test/test-http.js",
    "verify": "node server/test/test-flows.js && node server/test/test-http.js",
    "seed": "cd server && node -e \"require('./src/storage/db.js').seedData()\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
