# ========================================================
# CaseBridge AICTE System — Production Environment Config
# Smart India Hackathon 2026 (SIH26264)
# ========================================================

# HTTP Port (Auto-detected on Render/Railway/Heroku if omitted)
PORT=5000

# Node Environment Mode ('production' or 'development')
NODE_ENV=production

# MongoDB Database URI (Optional: System seamlessly falls back to persistent local storage if offline)
# Local: mongodb://localhost:27017/casebridge
# Docker Compose: mongodb://mongo:27017/casebridge
# Atlas Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/casebridge?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/casebridge

# JWT Authentication Secret Key (Required: Replace with a secure random string in production)
JWT_SECRET=casebridge_jwt_production_secret_key_sih2026_aicte_secure

# Public Base URL of the Web Application
CLIENT_URL=http://localhost:5000

# Demo Mode Enabled (Pre-populates sample AICTE institutions, cases, and officials for SIH evaluation)
DEMO_MODE=true
